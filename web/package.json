		"@sveltejs/kit": "3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.18",
		"@tailwindcss/vite": "^4.3.5",
		"bits-ui": "^2.11.4",
		"clsx": "^2.1.1",
		"esbuild": "^0.28.2",
		"formsnap": "^2.1.0",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.4.2",
